{
  "Application": {
    "Name": "Orca",
    "Version": "10.1.28000.2526",
    "Description": "Orca is a database table editor for creating and editing Windows Installer packages and merge modules. The tool provides a graphical interface for validation, highlighting the particular entries where validation errors or warnings occur.",
    "Publisher": "Microsoft",
    "Developer": "Microsoft",
    "Owner": "TheLab",
    "FeaturedApp": false,
    "AllowAvailableUninstall": true
  },
  "Install": {
    "Command": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File \"setup.ps1\"",
    "Arguments": "-Action Install",
    "Context": "System",
    "RestartBehavior": "Suppress",
    "TimeoutMinutes": 60
  },
  "Uninstall": {
    "Command": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File \"setup.ps1\"",
    "Arguments": "-Action Uninstall"
  },
  "Detection": {
    "Type": "PowerShell",
    "Script": "detection.ps1",
    "RunAs32Bit": false,
    "EnforceSignatureCheck": false
  },
  "Requirements": {
    "Architecture": "x64x86",
    "MinSupportedWinRelease": "W11_22H2"
  }
}
