{
  "Application": {
    "Name": "7-Zip",
    "Version": "26.02",
    "Description": "7-Zip is a free and open-source file archiver that allows users to compress and decompress files in various formats.",
    "Publisher": "Igor Pavlov",
    "Developer": "Igor Pavlov",
    "Owner": "TheLab",
    "FeaturedApp": false,
    "AllowAvailableUninstall": true
  },
  "Install": {
    "Command": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File \"setup.ps1\"",
    "Arguments": "-Action Install",
    "Context": "System",
    "RestartBehavior": "Suppress",
    "TimeoutMinutes": 60
  },
  "Uninstall": {
    "Command": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File \"setup.ps1\"",
    "Arguments": "-Action Uninstall"
  },
  "Detection": {
    "Type": "PowerShell",
    "Script": "detection.ps1",
    "RunAs32Bit": false,
    "EnforceSignatureCheck": false
  },
  "Requirements": {
    "Architecture": "x64x86",
    "MinSupportedWinRelease": "W11_22H2"
  }
}
